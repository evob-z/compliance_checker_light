# Compliance Checker MCP Service 环境变量配置
# =============================================================================
# 配置说明：
#   - 简单模式：同一厂商提供所有模型，只需配置 LLM_API_KEY + 模型名称
#   - 高级模式：不同厂商混用，可分别配置各服务的 API Key 和端点
# =============================================================================

# ==================== 基础配置（必需） ====================
# API 密钥 - 默认用于所有服务（LLM、嵌入模型、视觉模型）
# 支持 OpenAI 格式或兼容的 API（DashScope、Moonshot、DeepSeek 等）
LLM_API_KEY=

# API 端点（可选，默认 OpenAI）
# OpenAI:       https://api.openai.com/v1
# DashScope:    https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot:     https://api.moonshot.cn/v1
# DeepSeek:     https://api.deepseek.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -------------------- 模型选择（简单模式） --------------------
# 只需选择模型名称，自动使用 LLM_API_KEY 和 LLM_BASE_URL

# 主模型（用于生成检查清单、合规分析）
# gpt-4o, qwen-max, moonshot-v1-8k, deepseek-chat
LLM_MODEL=qwen-max

# 嵌入模型（用于文件名语义匹配）
# 留空则使用简单字符匹配（无需 API）
# text-embedding-v1 (DashScope), text-embedding-3-small (OpenAI)
EMBED_MODEL=text-embedding-v1

# 视觉模型（用于印章/签名检测）
# 默认使用OpenAI 兼容模式模型
VISION_MODEL=qwen3-vl-flash

# ==================== 高级配置（可选） ====================
# 当各服务使用不同厂商时，可单独配置

# ---- 嵌入模型独立配置 ----
# EMBED_API_KEY=your-embed-api-key      # 默认使用 LLM_API_KEY
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 视觉模型独立配置 ----
# VISION_API_KEY=your-vision-api-key    # 默认使用 LLM_API_KEY
# VISION_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ==================== OCR 配置（可选） ====================
# OCR 后端选择：none（默认，无 OCR）/ paddle（本地）/ aliyun（云端）
# - none: 不启用 OCR，仅处理可编辑 PDF（最轻量）
# - paddle: 本地 PaddleOCR，体积大(~500MB)但无需网络
# - aliyun: 阿里云 OCR，轻量但需网络和付费
OCR_BACKEND=none

# 阿里云 OCR 配置（当 OCR_BACKEND=aliyun 时必需）
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# ==================== 请求参数（可选） ====================
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

