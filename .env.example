# Compliance Checker Skill 环境变量配置

# ==================== LLM 配置（必需） ====================
# LLM API 密钥 - 用于将自然语言转换为检查清单
# 支持 OpenAI 格式或兼容的 API（如 DashScope、Moonshot 等）
LLM_API_KEY=your-api-key-here

# LLM API 端点（可选，默认使用 OpenAI）
# OpenAI: https://api.openai.com/v1
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot: https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型名称（可选，默认 gpt-4o）
# 推荐模型：
# - gpt-4o (OpenAI)
# - qwen-max (DashScope)
# - moonshot-v1-8k (Moonshot)
LLM_MODEL=gpt-4o

# LLM 请求超时时间（秒，默认 60）
LLM_TIMEOUT=60

# LLM 最大重试次数（默认 3）
LLM_MAX_RETRIES=3

# ==================== Qwen-VL 配置（可选） ====================
# 用于视觉检查（印章/签名检测）
# 如果不配置，视觉检查功能将不可用
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ==================== 嵌入模型配置（可选） ====================
# 用于语义匹配（文件名相似度计算）
# 默认使用 text-embedding-v1（DashScope）
# 如果未配置或 LLM 嵌入不可用，将使用备用方案
# EMBED_MODEL=text-embedding-v1

# ==================== 其他配置（可选） ====================
# 默认文档路径
# DEFAULT_DOCUMENT_PATH=/data/documents

# 输出目录
# OUTPUT_DIR=/output

# 日志级别
# LOG_LEVEL=INFO
